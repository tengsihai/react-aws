# 后端 API Base URL，已包含 stage 前缀，结尾不要带 /
# dev 环境：https://x4oneny2hi.execute-api.ap-northeast-1.amazonaws.com/dev
# CI 构建时读取 GitHub 环境变量 VITE_API_BASE_URL 自动注入
VITE_API_BASE_URL=https://x4oneny2hi.execute-api.ap-northeast-1.amazonaws.com/dev

# 环境标识：dev / staging / prod，用于页面顶部环境徽标；本地不填时显示 local
# VITE_APP_ENV=dev
